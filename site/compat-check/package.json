{
	"name": "aicp-compat-check",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "tsc -p tsconfig.json && tsc -p tsconfig.page.json",
		"deploy": "npm run build && wrangler deploy",
		"test": "tsc -p tsconfig.json && tsc -p tsconfig.page.json && tsc -p tsconfig.worker.json --noEmit && node --test \"build/test/*.test.js\""
	},
	"devDependencies": {
		"@cloudflare/workers-types": "5.20261004.1",
		"@types/node": "22.20.5",
		"typescript": "7.0.2",
		"wrangler": "4.147.0"
	}
}
