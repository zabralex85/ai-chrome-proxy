{
	"name": "aicp-compat",
	"main": "src/worker/index.ts",
	"compatibility_date": "2026-10-04",
	"assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
	"d1_databases": [
		{ "binding": "DB", "database_name": "aicp-compat", "database_id": "<your-d1-database-id>" }
	],
	// Per-IP limit on POST /api/report (period must be 10 or 60 seconds; namespace_id is any number unique in your account).
	"ratelimits": [
		{ "name": "REPORT_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
	]
	// Optional custom domain:
	// "routes": [{ "pattern": "check.example.com", "custom_domain": true }]
}
