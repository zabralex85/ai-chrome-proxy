@page "/"
@using System.Diagnostics
@using AiChromeProxy.Client.Sync
@using AiChromeProxy.Client.Transport
@using AiChromeProxy.Domain
@inject ITransport Transport
@inject SyncEngine Engine
@inject HttpClient Http
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>@(Engine.FolderName is null ? "ai-chrome-proxy" : $"{Engine.FolderName} — ai-chrome-proxy")</PageTitle>

<div class="shell @(_dragging is null ? null : "resizing")" data-testid="shell" data-theme="@_theme"
     style="--left-width: @(_filesOpen ? _leftWidth : 0)px; --right-width: @(_historyOpen ? _rightWidth : 0)px">
    <TopBar FolderName="@Engine.FolderName" State="@Transport.State" PingMs="@_pingMs" Theme="@_theme" OnToggleTheme="ToggleThemeAsync" User="@_user"
            FilesOpen="@_filesOpen" OnToggleFiles="() => _filesOpen = !_filesOpen"
            HistoryOpen="@_historyOpen" OnToggleHistory="() => _historyOpen = !_historyOpen" />
    @if (_filesOpen)
    {
        <Explorer Engine="Engine" Selected="@(TabSet.IsFile(_tabs.Active) ? _tabs.Active : null)" OnSelect="path => _tabs.Show(path)"
                  OnShowErrors="() => _tabs.Show(TabSet.Errors)" />
        <div class="resizer resizer-left" data-testid="sidebar-resizer" role="separator" tabindex="0" aria-orientation="vertical" aria-label="Resize the file tree"
             aria-valuenow="@_leftWidth" aria-valuemin="@MinWidth" aria-valuemax="@MaxWidth"
             @onpointerdown="e => StartDrag(Side.Left, e)" @onkeydown="e => ResizeByKey(Side.Left, e)"></div>
    }
    <MainArea Engine="Engine" Tabs="_tabs" OnChanged="() => { }" />
    @if (_historyOpen)
    {
        <ActionsHistory Engine="Engine" State="@Transport.State" PingMs="@_pingMs" />
        <div class="resizer resizer-right" data-testid="history-resizer" role="separator" tabindex="0" aria-orientation="vertical" aria-label="Resize the actions history"
             aria-valuenow="@_rightWidth" aria-valuemin="@MinWidth" aria-valuemax="@MaxWidth"
             @onpointerdown="e => StartDrag(Side.Right, e)" @onkeydown="e => ResizeByKey(Side.Right, e)"></div>
    }
    @if (_dragging is not null)
    {
        @* Catches the pointer anywhere while a panel edge is dragged; only rendered during the drag. *@
        <div class="resize-overlay" @onpointermove="OnDrag" @onpointerup="() => _dragging = null" @onpointerleave="() => _dragging = null"></div>
    }
</div>

@code {
    private const string ThemeKey = "aicp-theme";
    private const int MinWidth = 180;
    private const int MaxWidth = 600;

    private readonly CancellationTokenSource _stop = new();
    private readonly TabSet _tabs = new();
    private string? _theme;
    private string? _user;
    private bool _filesOpen = true;
    private bool _historyOpen = true;
    private int _leftWidth = 280;
    private int _rightWidth = 300;
    private Side? _dragging;
    private double _dragStartX;
    private int _dragStartWidth;
    private long? _pingMs;

    private enum Side
    {
        Left,
        Right,
    }

    public void Dispose()
    {
        Transport.StateChanged -= OnStateChanged;
        Engine.Changed -= OnEngineChanged;
        _stop.Cancel();
        _stop.Dispose();
    }

    protected override async Task OnInitializedAsync()
    {
        Transport.StateChanged += OnStateChanged;
        Engine.Changed += OnEngineChanged;
        _theme = await ReadThemeAsync();
        if (Transport.State == TransportState.Disconnected)
        {
            _ = Transport.ConnectForeverAsync(Task.Delay, _stop.Token);
        }

        _ = LoadUserAsync();
        await Engine.InitializeAsync();
        _ = Engine.RunAsync(_stop.Token);
        _ = PingEveryAsync(TimeSpan.FromSeconds(15));
    }

    private void StartDrag(Side side, PointerEventArgs e)
    {
        _dragging = side;
        _dragStartX = e.ClientX;
        _dragStartWidth = side == Side.Left ? _leftWidth : _rightWidth;
    }

    private void OnDrag(PointerEventArgs e)
    {
        var dx = (int)(e.ClientX - _dragStartX);
        Resize(_dragging!.Value, _dragging == Side.Left ? _dragStartWidth + dx : _dragStartWidth - dx);
    }

    /// <summary>Arrow keys on a focused panel edge move it by 16 px (towards the arrow).</summary>
    private void ResizeByKey(Side side, KeyboardEventArgs e)
    {
        var step = e.Key switch
        {
            "ArrowLeft" => -16,
            "ArrowRight" => 16,
            _ => 0,
        };
        Resize(side, side == Side.Left ? _leftWidth + step : _rightWidth - step);
    }

    private void Resize(Side side, int width)
    {
        width = Math.Clamp(width, MinWidth, MaxWidth);
        if (side == Side.Left)
        {
            _leftWidth = width;
        }
        else
        {
            _rightWidth = width;
        }
    }

    private async Task LoadUserAsync()
    {
        try
        {
            _user = await AccessIdentity.EmailAsync(Http, _stop.Token);
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
            // Disposed.
        }
    }

    private void OnEngineChanged() => InvokeAsync(StateHasChanged);

    private void OnStateChanged(TransportState state)
    {
        if (state == TransportState.Connected)
        {
            _ = PingAsync();
        }

        InvokeAsync(StateHasChanged);
    }

    private async Task PingEveryAsync(TimeSpan interval)
    {
        using (var timer = new PeriodicTimer(interval))
        {
            try
            {
                while (await timer.WaitForNextTickAsync(_stop.Token))
                {
                    await PingAsync();
                }
            }
            catch (OperationCanceledException)
            {
                // Disposed.
            }
        }
    }

    private async Task PingAsync()
    {
        if (Transport.State != TransportState.Connected)
        {
            return;
        }

        var watch = Stopwatch.StartNew();
        try
        {
            await Transport.RequestAsync(Envelope.Create(MessageTypes.Ping, new { }), TimeSpan.FromSeconds(5), _stop.Token);
            _pingMs = watch.ElapsedMilliseconds;
        }
        catch (Exception) when (!_stop.IsCancellationRequested)
        {
            _pingMs = null;
        }

        await InvokeAsync(StateHasChanged);
    }

    /// <summary>System → light → dark → system; the choice is kept in localStorage (no attribute = follow the system).</summary>
    private async Task ToggleThemeAsync()
    {
        _theme = _theme switch
        {
            null => "light",
            "light" => "dark",
            _ => null,
        };

        try
        {
            if (_theme is null)
            {
                await JS.InvokeVoidAsync("localStorage.removeItem", ThemeKey);
            }
            else
            {
                await JS.InvokeVoidAsync("localStorage.setItem", ThemeKey, _theme);
            }
        }
        catch (JSException)
        {
            // Storage blocked: the choice lasts for this page only.
        }
    }

    private async Task<string?> ReadThemeAsync()
    {
        try
        {
            var stored = await JS.InvokeAsync<string?>("localStorage.getItem", ThemeKey);
            return stored is "light" or "dark" ? stored : null;
        }
        catch (JSException)
        {
            return null;
        }
    }
}
