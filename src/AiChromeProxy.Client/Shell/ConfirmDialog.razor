@* A modal question: Cancel has the focus, Esc cancels, Tab stays inside. Backticks in the text mark a path (shown as code). *@
<div class="dialog-backdrop" data-testid="dialog-backdrop" @onclick="() => OnCancel.InvokeAsync()">
    <div class="dialog" role="dialog" aria-modal="true" aria-labelledby="dialog-title" aria-describedby="dialog-body" data-testid="confirm-dialog"
         @onclick:stopPropagation="true" @onkeydown="OnKeyDownAsync" @onkeydown:preventDefault="true" @onkeydown:stopPropagation="true">
        <h2 id="dialog-title" class="dialog-title" data-testid="dialog-title">
            @foreach (var (text, code) in Segments(Title))
            {
                if (code)
                {
                    <code>@text</code>
                }
                else
                {
                    @text
                }
            }
        </h2>
        <p id="dialog-body" class="dialog-body" data-testid="dialog-body">@Body</p>
        @if (Error is not null)
        {
            <p class="state-error" role="alert" data-testid="dialog-error">@Error</p>
        }
        <div class="dialog-actions">
            <button type="button" class="button secondary" data-testid="dialog-cancel" @ref="_cancel" @onfocus="() => _focused = 0" @onclick="() => OnCancel.InvokeAsync()">Cancel</button>
            <button type="button" class="button danger" data-testid="dialog-confirm" @ref="_confirm" @onfocus="() => _focused = 1" @onclick="ConfirmAsync">@ConfirmText</button>
        </div>
    </div>
</div>

@code {
    private ElementReference _cancel;
    private ElementReference _confirm;
    private int _focused;
    private bool _busy;

    [Parameter, EditorRequired]
    public string Title { get; set; } = null!;

    [Parameter, EditorRequired]
    public string Body { get; set; } = null!;

    [Parameter]
    public string ConfirmText { get; set; } = "Delete";

    /// <summary>Why the action failed, shown in the dialog (which stays open).</summary>
    [Parameter]
    public string? Error { get; set; }

    [Parameter, EditorRequired]
    public EventCallback OnConfirm { get; set; }

    [Parameter, EditorRequired]
    public EventCallback OnCancel { get; set; }

    /// <summary>The text cut at its backticks: even parts are plain, odd parts are code.</summary>
    private static IEnumerable<(string Text, bool Code)> Segments(string text) =>
        text.Split('`').Select((part, i) => (part, i % 2 == 1)).Where(s => s.part.Length > 0);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await _cancel.FocusAsync();
        }
    }

    // Every key is handled here (the default is prevented): Tab and arrows cycle the two buttons, Enter and Space press the focused one.
    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "Escape":
                await OnCancel.InvokeAsync();
                break;
            case "Tab" or "ArrowLeft" or "ArrowRight":
                _focused = 1 - _focused;
                await (_focused == 0 ? _cancel : _confirm).FocusAsync();
                break;
            case "Enter" or " ":
                if (_focused == 0)
                {
                    await OnCancel.InvokeAsync();
                }
                else
                {
                    await ConfirmAsync();
                }

                break;
        }
    }

    private async Task ConfirmAsync()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        try
        {
            await OnConfirm.InvokeAsync();
        }
        finally
        {
            _busy = false;
        }
    }
}
