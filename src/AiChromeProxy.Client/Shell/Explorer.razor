@using AiChromeProxy.Client.Packages
@using AiChromeProxy.Client.Sync

<aside class="panel panel-left @(Collapsed ? "collapsed" : null)" data-testid="file-tree" aria-label="Files">
    <header class="panel-header">
        <div class="left-tabs" role="tablist" aria-label="Left panel" @onkeydown="OnTabKey">
            <button type="button" role="tab" class="left-tab @(_packages ? null : "active")" aria-selected="@(_packages ? "false" : "true")" tabindex="@(_packages ? -1 : 0)"
                    data-testid="left-tab-explorer" @onclick="() => _packages = false">Explorer</button>
            <button type="button" role="tab" class="left-tab @(_packages ? "active" : null)" aria-selected="@(_packages ? "true" : "false")" tabindex="@(_packages ? 0 : -1)"
                    data-testid="left-tab-packages" @onclick="() => _packages = true">Packages</button>
        </div>
    </header>
    @if (_packages)
    {
        <div class="panel-body">
            <PackagesView Engine="Packages" />
        </div>
    }
    <div class="panel-body" data-testid="explorer" hidden="@_packages">
        @if (Engine.Folder == FolderStatus.Unsupported)
        {
            <div class="empty-state" role="alert" data-testid="unsupported">
                <Icon Name="warning" Size="32" Class="empty-icon" />
                <p>@SyncEngine.Unsupported</p>
            </div>
        }
        else if (Engine.Folder == FolderStatus.None)
        {
            <div class="empty-state">
                <Icon Name="folder-open" Size="32" Class="empty-icon" />
                <p>No folder is open. Pick the repository folder to mirror it to the home server.</p>
                <button type="button" class="button primary" data-testid="open-folder" @onclick="Engine.OpenFolderAsync">Open folder</button>
                @if (Engine.Problem is { } problem)
                {
                    <p class="state-error" role="alert" data-testid="open-folder-error">@problem</p>
                }
            </div>
        }
        else
        {
            var notice = Engine.Folder == FolderStatus.NeedsPermission || Engine.Blocked;
            <div class="folder-row">
                <Icon Name="folder" Class="kind-folder" />
                <span class="folder-name" title="@Engine.FolderName">@Engine.FolderName</span>
                @if (!notice)
                {
                    <button type="button" class="button link" data-testid="change-folder" @onclick="Engine.OpenFolderAsync">Change</button>
                }
            </div>
            @if (notice)
            {
                <div class="notice" role="alert">
                    <p>
                        <Icon Name="@(Engine.Blocked ? "warning" : "lock")" />
                        @(Engine.Blocked ? Engine.Problem : "Chrome needs your permission again to read this folder.")
                    </p>
                    <div class="notice-actions">
                        <button type="button" class="button primary" data-testid="restore-access" @onclick="Engine.RestoreAccessAsync">Restore access</button>
                        <button type="button" class="button secondary" data-testid="change-folder" @onclick="Engine.OpenFolderAsync">Change folder</button>
                    </div>
                </div>
            }
            <div class="sync-summary" data-testid="sync-summary">
                <div><strong>@Format.Count(Engine.SyncedCount)</strong> / @Format.Count(Engine.SyncableCount) files synced · @Format.Bytes(Engine.SyncedBytes)</div>
                <div class="muted">Last sync: @Format.Ago(Engine.LastSync, DateTimeOffset.Now)</div>
                @if (Engine.Phase == SyncPhase.Uploading && Engine.UploadTotal > 0)
                {
                    <div class="progress" role="progressbar" aria-label="Upload progress" aria-valuemin="0" aria-valuemax="@Engine.UploadTotal" aria-valuenow="@Engine.UploadDone">
                        <span style="width: @(Engine.UploadDone * 100 / Engine.UploadTotal)%"></span>
                    </div>
                }
            </div>
            @if (RemoteBanner.Of(Engine) is { } banner)
            {
                <div class="banner" role="status" data-testid="server-changes">
                    <Icon Name="sync" />
                    <span>@banner.Text</span>
                    @if (banner.Button == RemoteBanner.AllowWriting)
                    {
                        @* Straight from the click: the browser asks for write access only on a user activation. *@
                        <button type="button" class="button link" data-testid="allow-writing" @onclick="Engine.AllowWritingAsync">@banner.Button</button>
                    }
                    else
                    {
                        <button type="button" class="button link" data-testid="apply-all" @onclick="() => Engine.ApplyAsync(null)">@banner.Button</button>
                    }
                </div>
            }
            <FileTreeView Engine="Engine" Selected="@Selected" OnSelect="OnSelect" OnRenamed="OnRenamed" OnDeleted="OnDeleted" />
        }
    </div>
    <SyncStatus Engine="Engine" OnShowErrors="OnShowErrors" OnShowConflict="OnShowConflict" />
</aside>

@code {
    [Parameter, EditorRequired]
    public SyncEngine Engine { get; set; } = null!;

    [Parameter, EditorRequired]
    public PackagesEngine Packages { get; set; } = null!;

    private bool _packages;

    private void OnTabKey(KeyboardEventArgs e)
    {
        if (e.Key is "ArrowLeft" or "ArrowRight" or "Home" or "End")
        {
            _packages = e.Key is "ArrowRight" or "End";
        }
    }

    /// <summary>Hidden by CSS but still rendered, so the tree keeps its state.</summary>
    [Parameter]
    public bool Collapsed { get; set; }

    /// <summary>The file of the active tab, highlighted in the tree.</summary>
    [Parameter]
    public string? Selected { get; set; }

    [Parameter]
    public EventCallback<string> OnSelect { get; set; }

    /// <summary>A file or folder was renamed in the tree: open tabs follow.</summary>
    [Parameter]
    public EventCallback<(string OldPath, string NewPath, bool IsFolder)> OnRenamed { get; set; }

    /// <summary>A file or folder was deleted in the tree: its tabs close.</summary>
    [Parameter]
    public EventCallback<(string Path, bool IsFolder)> OnDeleted { get; set; }

    [Parameter]
    public EventCallback OnShowErrors { get; set; }

    /// <summary>The status-bar conflict count was clicked.</summary>
    [Parameter]
    public EventCallback OnShowConflict { get; set; }
}

