@using AiChromeProxy.Client.Chat
@using AiChromeProxy.Client.Navigator
@using AiChromeProxy.Client.Sync
@inject ChatEngine Chat

<section class="center" aria-label="Main">
    @* aria-activedescendant like the tree: one tab stop, arrows switch tabs, Delete closes the active one. *@
    <div class="tabbar">
    <div class="tabstrip" role="tablist" tabindex="0" aria-label="Open tabs" data-testid="tabs" aria-activedescendant="@TabId(Tabs.Active)" @onkeydown="OnKeyDown">
        @foreach (var id in Tabs.Open)
        {
            var active = id == Tabs.Active;
            var path = TabSet.SelectedPath(id);
            <div id="@TabId(id)" role="tab" class="tab @(active ? "active" : null)" aria-selected="@(active ? "true" : "false")" aria-controls="tab-panel"
                 data-testid="@TestId(id)" data-path="@path" title="@path" @onclick="() => SelectAsync(id)">
                @switch (id)
                {
                    case TabSet.Welcome:
                        <Icon Name="logo" Class="kind-welcome" />
                        <span class="tab-label">Welcome</span>
                        break;
                    case TabSet.Errors:
                        <Icon Name="error" Class="kind-error" />
                        <span class="tab-label">Errors</span>
                        break;
                    case TabSet.Settings:
                        <Icon Name="gear" Class="kind-file" />
                        <span class="tab-label">Project settings</span>
                        break;
                    case var _ when TabSet.IsConflict(id):
                        <Icon Name="conflict" Class="kind-conflict" />
                        <span class="tab-label">Conflict: @FileName(path!)</span>
                        break;
                    case var _ when TabSet.IsChat(id):
                        <Icon Name="chat" Class="kind-chat" />
                        <span class="tab-label">@ChatLabel(id)</span>
                        break;
                    default:
                        var kind = Format.FileKind(path!);
                        <Icon Name="@("file-" + kind)" Class="@("kind-" + kind)" />
                        <span class="tab-label">@FileName(path!)</span>
                        break;
                }
                @if (id != TabSet.Welcome)
                {
                    <button type="button" class="tab-close" tabindex="-1" aria-label="@($"Close {Label(id)}")" title="Close"
                            @onclick="() => SelectAsync(id, close: true)" @onclick:stopPropagation="true">
                        <Icon Name="close" Size="14" />
                    </button>
                }
            </div>
        }
        <span class="tabstrip-fill"></span>
    </div>
    <div class="chat-menu-host">
        <button type="button" class="chat-menu-button" data-testid="chat-menu-button" aria-haspopup="menu" aria-expanded="@(_menuOpen ? "true" : "false")"
                title="Chats" @onclick="() => _menuOpen = !_menuOpen">
            <Icon Name="chat" Size="14" /><span>Chats</span><Icon Name="chevron-down" Size="12" />
        </button>
        @if (_menuOpen)
        {
            <button type="button" class="menu-backdrop" tabindex="-1" aria-label="Close the chats menu" @onclick="() => _menuOpen = false"></button>
            <div class="chat-menu" role="menu" data-testid="chat-menu" aria-label="Chats" @onkeydown="OnMenuKey">
                <button type="button" role="menuitem" class="chat-menu-item new-chat" data-testid="new-chat" @onclick="NewChatAsync">
                    <Icon Name="plus" Size="14" /><span>New chat</span>
                </button>
                @foreach (var info in Chat.Sessions)
                {
                    <button type="button" role="menuitem" class="chat-menu-item @(info.Id == Chat.Current.Id ? "current" : null)" data-testid="chat-session" @key="info.Id"
                            @onclick="() => OpenChatAsync(info.Id)">
                        @if (info.Running)
                        {
                            <Icon Name="sync" Size="14" Class="spin" />
                        }
                        else
                        {
                            <Icon Name="chat" Size="14" />
                        }
                        <span class="chat-menu-title">@(info.Title.Length > 0 ? info.Title : "Chat")</span>
                        <span class="muted chat-menu-time">@Format.Ago(info.Updated, DateTimeOffset.UtcNow)</span>
                    </button>
                }
                @if (Chat.Sessions.Count == 0)
                {
                    <div class="chat-menu-empty muted">No earlier chats in this folder.</div>
                }
            </div>
        }
    </div>
    </div>

    <div id="tab-panel" class="tab-panel @(TabSet.IsFile(Tabs.Active) ? "tab-panel-file" : null)" role="tabpanel" aria-labelledby="@TabId(Tabs.Active)" data-testid="main">
        @switch (Tabs.Active)
        {
            case TabSet.Welcome:
                <section class="welcome" data-testid="welcome">
                    <div class="welcome-mark"><Icon Name="logo" Size="40" /></div>
                    <h1>ai-chrome-proxy</h1>
                    <p class="lead">Work on the repository in this browser with Claude Code running on your home server. The folder you open here is mirrored to the server and kept in sync.</p>
                    <ol class="steps">
                        <li>
                            <span class="step-number">1</span>
                            <div><strong>Open folder</strong><p>Pick the repository folder in the file tree. Secrets (<code>.env</code>, keys) and build output are never sent.</p></div>
                        </li>
                        <li>
                            <span class="step-number">2</span>
                            <div><strong>Wait for the sync</strong><p>The status under the file tree shows the progress; later edits follow within about 10 seconds.</p></div>
                        </li>
                        <li>
                            <span class="step-number">3</span>
                            <div><strong>Chat</strong><p>Ask Claude about the code in the chat box below; answers stream in with diagrams, and its edits come back to your folder.</p></div>
                        </li>
                    </ol>
                </section>
                break;
            case TabSet.Errors:
                var errors = Engine.Errors;
                <section class="errors" data-testid="error-list">
                    <h1>Errors <span class="count">@errors.Count</span></h1>
                    @if (errors.Count == 0)
                    {
                        <p class="muted">No errors.</p>
                    }
                    else
                    {
                        <ul>
                            @foreach (var error in errors)
                            {
                                <li><Icon Name="error" Class="kind-error" /><span>@error</span></li>
                            }
                        </ul>
                    }
                </section>
                break;
            case TabSet.Settings:
                <ProjectSettingsView Engine="Engine" />
                break;
            case var chatTab when TabSet.IsChat(chatTab):
                <ChatView Chat="Chat" OnOpenFile="OnOpenFile" />
                break;
            case var conflictTab when TabSet.IsConflict(conflictTab):
                <ConflictView Engine="Engine" Path="@(TabSet.ConflictPath(conflictTab)!)" />
                break;
            default:
                // A file tab: its viewer is rendered below, for every open file tab.
                break;
        }
        @{
            SyncPool();
        }
        @foreach (var id in Tabs.Open.Where(TabSet.IsFile))
        {
            var path = TabSet.PathOf(id)!;
            <FileView @key="(Engine.FolderGeneration, id)" Engine="Engine" Path="@path" Active="@(id == Tabs.Active)" Live="@Pool.Contains(path)" Link="Link" />
        }
    </div>

    <ChatInput Chat="Chat" Enabled="ChatEnabled" Placeholder="@Format.ChatPlaceholder(ChatConnected, ChatFolderOpen)" OnSend="SendAsync" />
</section>

@code {
    [Parameter, EditorRequired]
    public SyncEngine Engine { get; set; } = null!;

    /// <summary>Owned by the page (the tree and the error count open tabs too).</summary>
    [Parameter, EditorRequired]
    public TabSet Tabs { get; set; } = null!;

    /// <summary>A <c>path:line</c> or <c>path#Symbol</c> link in the chat was clicked: the page opens the file's tab and passes the link back as <see cref="Link"/>.</summary>
    [Parameter]
    public EventCallback<FileLink> OnOpenFile { get; set; }

    /// <summary>The last chat link that was clicked; its file's viewer reveals it once.</summary>
    [Parameter]
    public FileLink? Link { get; set; }

    /// <summary>The connection is up.</summary>
    [Parameter]
    public bool ChatConnected { get; set; }

    /// <summary>A folder is open and synced.</summary>
    [Parameter]
    public bool ChatFolderOpen { get; set; }

    /// <summary>The chat input is enabled: connected, with a folder open.</summary>
    private bool ChatEnabled => ChatConnected && ChatFolderOpen;

    /// <summary>Raised after every tab change so the page re-renders (the tree highlights the active file).</summary>
    [Parameter]
    public EventCallback OnChanged { get; set; }

    private static string FileName(string path) => path[(path.LastIndexOf('/') + 1)..];

    private static string Label(string id) => id switch
    {
        TabSet.Welcome => "Welcome",
        TabSet.Errors => "Errors",
        TabSet.Settings => "Project settings",
        _ when TabSet.IsConflict(id) => "Conflict: " + FileName(TabSet.ConflictPath(id)!),
        _ when TabSet.IsChat(id) => "chat",
        _ => FileName(TabSet.PathOf(id)!),
    };


    private static string TestId(string id) => id switch
    {
        TabSet.Welcome => "tab-welcome",
        TabSet.Errors => "tab-errors",
        TabSet.Settings => "tab-settings",
        _ when TabSet.IsConflict(id) => "tab-conflict",
        _ when TabSet.IsChat(id) => "tab-chat",
        _ => "tab-file",
    };

    private string TabId(string id) => $"tab-{Tabs.Open.ToList().IndexOf(id)}";

    private bool _menuOpen;
    private int _generation;

    /// <summary>Which file tabs may hold a live editor (at most <see cref="ViewerPool.Capacity"/>).</summary>
    private ViewerPool Pool { get; } = new();

    /// <summary>Before the file views render: forgets closed tabs and the old folder's, and marks the tab on screen as the most recently shown.</summary>
    private void SyncPool()
    {
        if (_generation != Engine.FolderGeneration)
        {
            _generation = Engine.FolderGeneration;
            Pool.Clear();
        }

        Pool.Keep([.. Tabs.Open.Where(TabSet.IsFile).Select(t => TabSet.PathOf(t)!)]);
        if (TabSet.PathOf(Tabs.Active) is { } active)
        {
            Pool.Touch(active);
        }
    }

    /// <summary>The tab's label: the chat's title, or "New chat" until the first message is sent.</summary>
    private string ChatLabel(string id)
    {
        if (TabSet.ChatSessionId(id) is not { } sessionId)
        {
            return "New chat";
        }

        var title = Chat.Current.Id == sessionId ? Chat.Current.Title : Chat.Sessions.FirstOrDefault(s => s.Id == sessionId)?.Title;
        return string.IsNullOrEmpty(title) ? "Chat" : title;
    }

    /// <summary>Focuses (or closes) a tab; a chat tab then shows its session.</summary>
    private async Task SelectAsync(string id, bool close = false)
    {
        if (close)
        {
            Tabs.Close(id);
        }
        else
        {
            Tabs.Show(id);
        }

        await ChatFollowsTabAsync();
        await OnChanged.InvokeAsync();
    }

    /// <summary>The chat on screen is the one of the active chat tab.</summary>
    private async Task ChatFollowsTabAsync()
    {
        if (!TabSet.IsChat(Tabs.Active))
        {
            return;
        }

        if (TabSet.ChatSessionId(Tabs.Active) is { } sessionId)
        {
            if (Chat.Current.Id != sessionId)
            {
                await Chat.OpenSessionAsync(sessionId);
            }
        }
        else if (!Chat.Current.IsDraft)
        {
            Chat.NewChat();
        }
    }

    private async Task NewChatAsync()
    {
        _menuOpen = false;
        Chat.NewChat();
        Tabs.Show(TabSet.ChatTab(null));
        await OnChanged.InvokeAsync();
    }

    private async Task OpenChatAsync(string sessionId)
    {
        _menuOpen = false;
        Tabs.Show(TabSet.ChatTab(sessionId));
        await ChatFollowsTabAsync();
        await OnChanged.InvokeAsync();
    }

    private void OnMenuKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            _menuOpen = false;
        }
    }

    /// <summary>Sends into the chat on screen; its tab opens (the draft's tab becomes the new session's tab).</summary>
    private async Task SendAsync(string text)
    {
        var tab = TabSet.ChatTab(Chat.Current.Id);
        Tabs.Show(tab);
        await OnChanged.InvokeAsync();
        await Chat.SendAsync(text);
        if (Chat.Current.Id is { } id && TabSet.ChatTab(id) != tab)
        {
            Tabs.Rename(tab, TabSet.ChatTab(id));
        }

        await OnChanged.InvokeAsync();
    }

    private Task OnKeyDown(KeyboardEventArgs e) => ChangeAsync(() =>
    {
        if (e.Key == "Delete")
        {
            Tabs.Close(Tabs.Active);
        }
        else
        {
            Tabs.OnKey(e.Key);
        }
    });

    private async Task ChangeAsync(Action change)
    {
        change();
        await ChatFollowsTabAsync();
        await OnChanged.InvokeAsync();
    }
}
