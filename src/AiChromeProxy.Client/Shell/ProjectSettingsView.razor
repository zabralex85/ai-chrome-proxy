@using AiChromeProxy.Client.Sync
@using AiChromeProxy.Domain.Sync

<section class="file-details settings" data-testid="settings">
    <div class="file-heading">
        <Icon Name="gear" Size="32" Class="kind-file" />
        <div>
            <h1>Project settings</h1>
            <div class="mono muted">@Engine.FolderName</div>
        </div>
    </div>
    <form @onsubmit="SaveAsync">
        <label class="field" for="settings-excludes">Extra excludes (.gitignore syntax)</label>
        <textarea id="settings-excludes" class="mono" rows="8" spellcheck="false" data-testid="settings-excludes" @bind="_form.Excludes" @bind:event="oninput"></textarea>
        <label class="check">
            <input type="checkbox" data-testid="settings-apply" @bind="_form.Apply" />
            Apply server changes automatically
        </label>
        <fieldset class="permissions" data-testid="settings-permissions">
            <legend class="field">Permissions</legend>
            <label class="choice">
                <input type="radio" name="permissions" value="ask" checked="@(_form.Permissions == "ask")" @onchange="@(() => _form.Permissions = "ask")" />
                <span>Ask before commands (edits are applied)</span>
            </label>
            <label class="choice">
                <input type="radio" name="permissions" value="all" checked="@(_form.Permissions == "all")" @onchange="@(() => _form.Permissions = "all")" />
                <span>Allow everything</span>
            </label>
            <label class="choice">
                <input type="radio" name="permissions" value="settings" checked="@(_form.Permissions == "settings")" @onchange="@(() => _form.Permissions = "settings")" />
                <span>Only what my Claude Code settings allow</span>
            </label>
        </fieldset>
        <label class="field" for="settings-model">Model</label>
        <input id="settings-model" class="text-input" type="text" spellcheck="false" autocomplete="off" placeholder="Claude Code's default"
               data-testid="settings-model" @bind="_form.Model" @bind:event="oninput" />
        <label class="field" for="settings-allowed">Always allowed (one rule per line)</label>
        <textarea id="settings-allowed" class="mono" rows="6" spellcheck="false" data-testid="settings-allowed" @bind="_form.AllowedTools" @bind:event="oninput"></textarea>
        <ClaudeToolsSection @ref="_tools" Form="_form" Changed="() => { }" />
        <div class="settings-actions">
            <button type="submit" class="button primary" data-testid="settings-save" disabled="@(!_form.IsDirty)">Save</button>
            <span role="status" class="@(_failed ? "state-error" : "muted")" data-testid="settings-status">@_status</span>
        </div>
    </form>
</section>

@code {
    private ProjectSettings _loaded = null!;
    private ProjectSettingsForm _form = null!;
    private ClaudeToolsSection? _tools;
    private string? _status;
    private bool _failed;

    [Parameter, EditorRequired]
    public SyncEngine Engine { get; set; } = null!;

    /// <summary>Reads the settings again: an Allow always rule may have been added since the folder was opened.</summary>
    protected override async Task OnInitializedAsync()
    {
        _loaded = Engine.Settings;
        _form = new ProjectSettingsForm(_loaded);
        try
        {
            await Engine.ReloadSettingsAsync();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            // Not connected: the form shows what the engine knows; saving reads them again.
            return;
        }

        if (!_form.IsDirty)
        {
            _loaded = Engine.Settings;
            _form = new ProjectSettingsForm(_loaded);
        }
    }

    /// <summary>Takes over what the engine knows (the server's reply to a save, a new session) unless it is being edited.</summary>
    protected override void OnParametersSet()
    {
        if (_form is null || (!_form.IsDirty && !ReferenceEquals(_loaded, Engine.Settings)))
        {
            _loaded = Engine.Settings;
            _form = new ProjectSettingsForm(_loaded);
        }
    }

    private async Task SaveAsync()
    {
        _status = null;
        _failed = false;
        try
        {
            await Engine.SaveSettingsAsync(_form.ToSettings);
            _loaded = Engine.Settings;
            _form = new ProjectSettingsForm(_loaded);
            _status = "Saved.";
            if (_tools is not null)
            {
                // The merge reads the switches at request time: what was switched off now shows so.
                await _tools.LoadAsync();
            }
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _failed = true;
            _status = $"Could not save: {ex.Message}";
        }
    }
}
