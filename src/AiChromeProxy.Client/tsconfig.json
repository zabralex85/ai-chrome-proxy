{
    "compilerOptions": {
        "strict": true,
        "noImplicitAny": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "noImplicitReturns": true,
        "noFallthroughCasesInSwitch": true,
        "target": "ES2022",
        "module": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "rootDir": "Scripts",
        "outDir": "wwwroot/js",
        "noEmitOnError": true,
        "newLine": "crlf"
    },
    "include": ["Scripts/**/*.ts"]
}
